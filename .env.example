# Copie para .env e ajuste.

# --- LLM ---------------------------------------------------------------
# fake      -> baseline extrativo, sem custo (padrão; usado no CI)
# anthropic -> Claude (precisa de ANTHROPIC_API_KEY)
# openai    -> qualquer API compatível com OpenAI: OpenAI, Groq, Ollama...
LLM_PROVIDER=fake
# LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# Exemplo Groq (tem plano gratuito):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# LLM_MODEL=<modelo com suporte a tool calling>

# Exemplo Ollama (local e grátis):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=<modelo com suporte a tool calling>

# Preço do modelo (US$ por 1 milhão de tokens) para calcular custo por conversa.
# Pegue os valores na página de preços do provedor.
PRICE_INPUT_PER_MTOK=0
PRICE_OUTPUT_PER_MTOK=0

# --- Recuperação --------------------------------------------------------
# hash  -> sem download, determinístico (CI)
# local -> sentence-transformers multilíngue (pip install -e ".[embeddings]")
# e5    -> intfloat/multilingual-e5-small (prefixos query:/passage:, mesmos extras)
EMBEDDER=hash
# E5_MODEL=intfloat/multilingual-e5-small   # ou multilingual-e5-base (768 dim: só em memória, não cabe no Postgres)
TOP_K=4
MIN_SCORE=0.12
MAX_STEPS=3

# --- Armazenamento ------------------------------------------------------
# memory   -> tudo em memória (padrão)
# postgres -> pgvector + RLS (docker compose up -d && python -m delivery_agent.ingest)
STORE=memory
# DATABASE_URL=postgresql://app_user:app_user_dev@localhost:5432/delivery
